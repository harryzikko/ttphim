NODE_ENV=development
PORT=3001
HOST=127.0.0.1
KKPHIM_API_BASE=https://phimapi.com
IMAGE_CDN=https://phimimg.com
# Production: generate a private random secret (at least 32 characters).
JWT_SECRET=
# Production: absolute path to db.json on persistent local storage, outside the checkout.
DB_PATH=
# Persistent directory for resized personal avatars; shared across replicas.
AVATAR_DIR=
# Production: canonical HTTPS origin, e.g. https://cinema.example.com
PUBLIC_ORIGIN=
# Additional trusted web origins, comma-separated; never use a wildcard.
ALLOWED_ORIGINS=
# Only set to the exact trusted reverse-proxy IP/subnet, never true for all clients.
TRUST_PROXY=
# Force a failed exit if graceful shutdown exceeds this deadline (100-30000 ms).
SHUTDOWN_TIMEOUT_MS=10000

# Optional transactional backend. Leave empty for local JSON/single instance.
DATABASE_URL=
# Set to replicated only after PostgreSQL migration and multi-instance verification.
DEPLOYMENT_MODE=single
# Generate a separate stable 32-byte hex key before enabling MFA (never reuse JWT_SECRET).
MFA_ENCRYPTION_KEY=
REQUIRE_ADMIN_MFA=false
REQUIRE_VERIFIED_EMAIL=false

# Production account email requires SMTP. Port 465 uses TLS; other ports require STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASS=

# Operations: external webhook must use HTTPS; monitoring is explicitly enabled.
ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=
SOURCE_MONITOR_ENABLED=false

# Automatic encrypted backup: absolute directory outside checkout, 32-byte hex key.
BACKUP_DIR=
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_MS=86400000
BACKUP_RETENTION=14
